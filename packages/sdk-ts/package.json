{
  "name": "@vexinter-ai/sdk",
  "version": "0.5.1",
  "description": "TypeScript/JavaScript SDK for Vexinter - Verifiable, recoverable, secure AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vexinter-AI/vexinter.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://vexinter.com",
  "bugs": "https://github.com/Vexinter-AI/vexinter/issues",
  "keywords": [
    "vexinter",
    "ai-agents",
    "verification",
    "recovery",
    "secure-communication",
    "ed25519",
    "audit-trail"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./crypto": {
      "import": "./dist/crypto/index.js",
      "types": "./dist/crypto/index.d.ts"
    },
    "./identity": {
      "import": "./dist/identity/index.js",
      "types": "./dist/identity/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "author": "Vexinter Team",
  "license": "SEE LICENSE IN LICENSE.txt",
  "dependencies": {
    "@noble/curves": "^1.5.0",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "LICENSE.txt",
    "README.md"
  ]
}