# Copy this file as .env (which is NOT versioned) and fill in the values.
# To generate a secret:  openssl rand -hex 24

# === Database ===
POSTGRES_PASSWORD=
# Optional (defaults in parentheses)
# POSTGRES_USER=vexinter
# POSTGRES_DB=vexinter_db

# === Service ===
VEXINTER_PG_DSN=postgresql://vexinter:CHANGE_ME@db:5432/vexinter_db
VEXINTER_AUTO_MIGRATE=1
# Control-plane token (required outside development)
VEXINTER_ADMIN_TOKEN=
# Optional: "ana:token1:viewer:2030-01-01T00:00:00Z,luis:token2:operator"
# (each token 12+ characters; supports role and ISO8601 expiry)
VEXINTER_OPERATOR_TOKENS=
# Session cookie flags. Secure defaults to ON, set 0 ONLY for local
# development over plain HTTP (browsers refuse Secure cookies without TLS).
VEXINTER_COOKIE_SECURE=0
# SameSite for the session cookie: strict (default) | lax | none
VEXINTER_COOKIE_SAMESITE=strict
# Optional: run the follow-up scheduler + memory cleanup in-process every
# N seconds (0/unset = disabled; use an external cron + the admin endpoints
# /v1/followups/run-due and /v1/memory/cleanup instead).
# NOTE: single-replica only, with several replicas each one fires the same
# due follow-ups; run exactly one scheduler (here or via cron/queue).
VEXINTER_SCHEDULER_INTERVAL_S=0
# 1 shows tracebacks: development only
VEXINTER_DEBUG=0
# "1" disables credential signature authentication: DEVELOPMENT ONLY
VEXINTER_DEV_MODE=0
# /keyring enables per-execution encryption (keys live in a separate volume)
VEXINTER_KEYRING_DIR=
# Deep memory (optional): SQLite vector index path + embedding settings.
# Vector search requires the `memory` extra (sqlite-vec); without it search
# is disabled with a loud warning. Provide a real embedding function via
# DeepMemoryService.set_embedding_function for semantic results, the
# built-in fallback is a deterministic hash, NOT semantic.
# VEXINTER_MEMORY_DB_PATH=
# VEXINTER_MEMORY_EMBEDDING_DIM=384
# VEXINTER_MEMORY_TTL_DAYS=365
# VEXINTER_MEMORY_REVERIFY_DAYS=30
# Additional Bearer token accepted on /metrics (Prometheus metrics)
VEXINTER_METRICS_TOKEN=
# Tool adapters: "pkg.module:Class,other:factory"
VEXINTER_ADAPTERS=
# Alternative Jinja console: login retries and lockout
VEXINTER_LOGIN_MAX_FAILS=5
VEXINTER_LOGIN_LOCK_S=900
# Compiled UI (Vite): alternative path to vexinter/app/dist
VEXINTER_UI_DIST=

# === Rate limiting / Redis (optional) ===
# VEXINTER_REDIS_URL=redis://localhost:6379/0
# VEXINTER_RATE_LIMIT_RPS=100
# VEXINTER_RATE_LIMIT_BURST=20

# === Agent key persistence (optional) ===
# AgentKeyStore: Ed25519/X25519 keys in encrypted SQLite (Fernet/PBKDF2)
# VEXINTER_KEYS_DB_PATH=./vexinter_agent_keys.db
# VEXINTER_KEYS_PASSWORD=
# VEXINTER_KEYS_SALT=
# External signer for checkpoint anchoring: local|aws_kms|gcp_kms|azure
# VEXINTER_HSM_TYPE=local

# === License enforcement (optional, requires the vexinter-pro package) ===
# These env vars are read by vexinter_pro.licensing — install the
# subscriber package (`pip install vexinter-pro`) for them to take
# effect. The Community Edition core ignores them.
# Paid customers receive all four values in their welcome email.
# Base URL serving the signed {customer_id}.json documents
# VEXINTER_LICENSE_BASE_URL=
# Customer id (format: lic_<16 hex chars>) — public identifier, not a secret
# VEXINTER_LICENSE_ID=
# Secret license/download token — sent as Bearer, never in URLs
# VEXINTER_LICENSE_TOKEN=
# Ed25519 public key (base64) matching the vendor signing key
# VEXINTER_LICENSE_PUBKEY=
# Optional: comma-separated EXTRA public keys accepted during a signing-key
# rotation. Set the new key as VEXINTER_LICENSE_PUBKEY and keep the old one
# here until customers have fetched re-signed license docs.
# VEXINTER_LICENSE_PUBKEYS=
# Cache file for the last valid document (default: tempdir, set a persistent
# path, e.g. a volume, so it survives container restarts)
# VEXINTER_LICENSE_CACHE=
# Optional: max age (seconds) of the stale cache used when the license server
# is unreachable. Default: 604800 (7 days). Set -1 only if you accept
# unlimited fail-open (a cancelled subscriber could keep a paid plan by
# blocking the license endpoint).
# VEXINTER_LICENSE_MAX_STALE_S=

# === Fallbacks for unlicensed/community mode ===
# VEXINTER_DEFAULT_PLAN is honored ONLY when VEXINTER_DEV_MODE=1. In
# production a paid plan requires a verified license document — env vars
# alone never unlock paid tiers. When a license IS configured but
# unreachable, the plan degrades to community (never to the env value).
# VEXINTER_DEFAULT_PLAN=
# VEXINTER_DEFAULT_SUBSCRIBER_EMAIL=

# === Execution guardrails (per task/execution) ===
# Conservative defaults bounding runaway agents; overridable per task
# via max_steps / deadline_s in POST /v1/tasks.
# VEXINTER_MAX_STEPS=100              # tool-call attempts per execution
# VEXINTER_TASK_DEADLINE_S=1800       # seconds per execution
# VEXINTER_LOOP_THRESHOLD=3           # identical consecutive calls
# VEXINTER_CYCLE_THRESHOLD=3          # repeats of a call-pattern cycle
# VEXINTER_NO_PROGRESS_WINDOW=8       # calls without a new outcome
# VEXINTER_MAX_SUBTASK_DEPTH=3        # delegation cascade depth
# VEXINTER_MAX_SUBTASKS_PER_TASK=32   # total subtasks per task tree
# VEXINTER_DEFAULT_MAX_TOKENS=100000  # token cap when client sets none
# VEXINTER_COMMUNITY_MAX_TOKENS=50000 # hard token ceiling, Community plan
